[sub_resource type="Environment" id="Environment_y5iem"]
background_mode = 2
sky = SubResource("sky_res")
ambient_light_source = 3
; Was 1.15, which lit every surface almost as brightly as the sun did and left
; the world shadowless and flat — the forest shots had no readable tree shadows
; at all. Ambient is fill, not key: at 0.55 the sun's shading actually shapes
; the terrain, and day_night_cycle still lerps this down to NIGHT_AMBIENT.
ambient_light_energy = 0.55
; Sky-coloured ambient is what makes shadows read as cool blue against warm
; sunlight rather than as grey. Slightly blue-shifted from pure sky to push it.
ambient_light_sky_contribution = 1.0
tonemap_mode = 3
tonemap_white = 2.2
tonemap_exposure = 1.05
ssao_enabled = true
ssao_radius = 1.4
ssao_intensity = 1.6
ssao_detail = 0.4
ssao_light_affect = 0.2
glow_enabled = true
glow_levels/2 = 0.2
glow_levels/4 = 0.6
glow_levels/6 = 0.3
glow_normalized = true
glow_intensity = 0.85
glow_strength = 1.1
glow_bloom = 0.08
glow_hdr_threshold = 0.95
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.66, 0.73, 0.82, 1)
fog_sun_scatter = 0.3
fog_density = 1.0
fog_aerial_perspective = 0.72
fog_sky_affect = 0.5
fog_height = 20.0
fog_height_density = 0.04
fog_depth_curve = 1.5
fog_depth_begin = 70.0
fog_depth_end = 820.0
adjustment_enabled = true
adjustment_contrast = 1.06
; Was 1.12. The island is overwhelmingly one hue, so boosting saturation made
; the whole world read as a single slab of green; the variation now comes from
; the colormap (see tools/paint_terrain.gd) instead of from a global multiplier.
adjustment_saturation = 1.0

