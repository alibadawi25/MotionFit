# Godot 4+ specific ignores
.godot/
/android/

# Dev tool output (screenshots + run logs)
/tools/shots/*
!/tools/shots/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Large ML data & model artifacts — not source. Regenerate or download these:
#  - datasets/            raw exercise videos used to train pose classifiers
#  - *.task               MediaPipe pose model (see README "Motion input")
#  - pose recordings      captured landmark streams produced by recording.py
/datasets/
*.task
/python/pose/recordings/*
!/python/pose/recordings/.gitkeep

# Local tooling / editor settings
.claude/

# Godot export / build output
/export/
/build/
*.tmp

# Throwaway scratch / inspection files kept at the project root (e.g. the model
# inspector or a one-off parse check). Anchored to root so a real _foo.gd in a
# subfolder is left alone.
/_*.gd
/_*.gd.uid
/_*.tscn
/_*.tscn.uid

# OS / editor cruft
.DS_Store
Thumbs.db
*~
